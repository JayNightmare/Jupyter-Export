{
	"name": "juypter-to-docx",
	"displayName": "Jupyter To Docx",
	"description": "Export Jupyter Notebooks to Word and PDF",
	"version": "0.0.1",
	"engines": {
		"vscode": "^1.75.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [
		"onLanguage:jupyter-notebook"
	],
	"main": "./out/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "jupyterToDocx.export",
				"title": "Export Notebook to Word/PDF"
			}
		],
		"configuration": {
			"title": "Jupyter To Docx",
			"properties": {
				"jupyterToDocx.outputDir": {
					"type": "string",
					"default": "docs/jupyter-notebook",
					"description": "Relative path to the output directory for exported files."
				},
				"jupyterToDocx.fontFamily": {
					"type": "string",
					"default": "Helvetica",
					"enum": [
						"Helvetica",
						"Times-Roman",
						"Courier"
					],
					"description": "Font family for PDF export."
				},
				"jupyterToDocx.fontSize": {
					"type": "number",
					"default": 12,
					"description": "Base font size for exported documents."
				}
			}
		}
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"pretest": "npm run compile && npm run lint",
		"lint": "eslint src",
		"test": "vscode-test"
	},
	"devDependencies": {
		"@types/jest": "^30.0.0",
		"@types/mocha": "^10.0.10",
		"@types/node": "16.x",
		"@types/vscode": "^1.75.0",
		"@vscode/test-cli": "^0.0.1",
		"@vscode/test-electron": "^2.0.0",
		"eslint": "^9.0.0",
		"typescript": "^5.0.0",
		"typescript-eslint": "^8.0.0"
	},
	"dependencies": {
		"docx": "^9.5.3",
		"pdf-lib": "^1.17.1",
		"remark-parse": "^11.0.0",
		"unified": "^11.0.5"
	}
}
