{
	"name": "jupyter-export",
	"displayName": "Jupyter Export",
	"description": "Export Jupyter Notebooks to Word and PDF",
	"version": "0.0.3",
	"icon": "src/media/icon.png",
	"engines": {
		"vscode": "^1.75.0"
	},
	"categories": [
		"Other",
		"Notebooks",
		"Data Science"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/JayNightmare/jupyter-export.git"
	},
	"bugs": {
		"url": "https://github.com/JayNightmare/jupyter-export/issues"
	},
	"homepage": "https://github.com/JayNightmare/jupyter-export#readme",
	"author": {
		"name": "JayNightmare",
		"email": "jn3.enquiries@gmail.com",
		"url": "https://github.com/JayNightmare"
	},
	"license": "MIT",
	"publisher": "JayNightmare",
	"keywords": [
		"jupyter",
		"notebook",
		"export",
		"word",
		"pdf"
	],
	"activationEvents": [
		"onLanguage:jupyter-notebook"
	],
	"main": "./out/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "jupyterExport.export",
				"title": "Export to Word/PDF",
				"icon": "$(export)"
			}
		],
		"menus": {
			"notebook/toolbar": [
				{
					"command": "jupyterExport.export",
					"group": "navigation",
					"when": "notebookType == jupyter-notebook"
				}
			]
		},
		"configuration": {
			"title": "Jupyter-Export",
			"properties": {
				"jupyterExport.outputDir": {
					"type": "string",
					"default": "docs/jupyter-notebook",
					"description": "Relative path to the output directory for exported files."
				},
				"jupyterExport.fontFamily": {
					"type": "string",
					"default": "Helvetica",
					"enum": [
						"Helvetica",
						"Times-Roman",
						"Courier"
					],
					"description": "Font family for PDF export."
				},
				"jupyterExport.fontSize": {
					"type": "number",
					"default": 12,
					"description": "Base font size for exported documents."
				}
			}
		}
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"pretest": "npm run compile && npm run lint",
		"lint": "eslint src",
		"test": "vscode-test"
	},
	"devDependencies": {
		"@types/jest": "^30.0.0",
		"@types/mocha": "^10.0.10",
		"@types/node": "16.x",
		"@types/vscode": "^1.75.0",
		"@vscode/test-cli": "^0.0.1",
		"@vscode/test-electron": "^2.0.0",
		"eslint": "^9.0.0",
		"typescript": "^5.0.0",
		"typescript-eslint": "^8.0.0"
	},
	"dependencies": {
		"docx": "^9.5.3",
		"pdf-lib": "^1.17.1",
		"remark-parse": "^11.0.0",
		"unified": "^11.0.5"
	}
}
